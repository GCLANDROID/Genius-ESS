<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center">
        <LinearLayout
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:background="@drawable/ovalwhite"
            android:gravity="center">
            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/logo"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.5">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_marginTop="30dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginLeft="35dp"
                    android:layout_marginRight="35dp"
                    >
                    <LinearLayout
                        android:layout_marginBottom="10dp"
                        android:layout_marginTop="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@drawable/lldesign21">
                        <Spinner
                            android:visibility="visible"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:id="@+id/spDomain"></Spinner>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:orientation="horizontal"
                        android:paddingRight="5dp">
                        <ImageView
                            android:layout_gravity="center"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/usericon_logo"/>
                        <EditText
                            android:imeOptions="actionNext"
                            android:paddingLeft="10dp"
                            android:singleLine="false"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:id="@+id/etUserId"
                            android:hint="UserId"
                            android:textSize="13sp"
                            android:textColor="@color/barcolor"/>
                    </LinearLayout>
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:visibility="gone"
                            android:orientation="horizontal"
                            android:id="@+id/llU1"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/color7"></LinearLayout>
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/llU"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/color5"></LinearLayout>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_marginTop="25dp"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:orientation="horizontal"
                        android:paddingRight="5dp">
                        <ImageView
                            android:layout_gravity="center"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_padlock"/>

                        <EditText
                            android:singleLine="false"
                            android:imeOptions="actionDone"
                            android:paddingLeft="10dp"
                            android:layout_width="210dp"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:id="@+id/etPassword"
                            android:hint="Password"
                            android:inputType="textPassword"
                            android:textSize="13sp"
                            android:textColor="@color/barcolor"/>
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="right"
                            >
                            <ImageView

                                android:id="@+id/imgSeen"
                                android:layout_gravity="center"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_eye"/>
                            <ImageView
                                android:id="@+id/imgHide"
                                android:visibility="gone"
                                android:layout_gravity="center"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_hide"/>
                        </FrameLayout>
                    </LinearLayout>
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:visibility="gone"
                            android:orientation="horizontal"
                            android:id="@+id/llP1"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/color7"></LinearLayout>
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/llP"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/color5"></LinearLayout>
                    </FrameLayout>





                    <LinearLayout
                        android:id="@+id/llSignIn"
                        android:layout_width="180dp"
                        android:layout_height="40dp"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="45dp"
                        android:background="@drawable/llgradientdesign">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textColor="@android:color/white"
                            android:text="LOGIN"/>
                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:layout_marginLeft="15dp"
                            android:src="@drawable/ic_right_arrow_forward"/>
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>
        </ScrollView>



    </LinearLayout>









</LinearLayout>

