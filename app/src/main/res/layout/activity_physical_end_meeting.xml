<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@mipmap/ccd_bg"
    android:orientation="vertical"
    tools:context=".activity.clientcall.PhysicalEndMeetingActivity">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="20dp"
        android:paddingHorizontal="10dp">
        <ImageView
            android:id="@+id/imgBack"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/backimg"
            app:tint="@color/white"></ImageView>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center">
            <TextView
                android:textAlignment="center"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textColor="@color/white"
                android:text="End Meeting"></TextView>
        </LinearLayout>
        <ImageView

            android:id="@+id/imgHome"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/homeimg"
            app:tint="@color/white"></ImageView>
    </LinearLayout>
    <ImageView
        android:src="@mipmap/end_meeting"
        android:layout_gravity="center"
        android:layout_width="280dp"
        android:layout_height="150dp"></ImageView>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/lldesign"
                android:padding="20dp"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textColor="@color/pinkone"
                            android:text="Client Name"></TextView>
                        <TextView
                            android:id="@+id/tvClientName"
                            android:layout_marginTop="5dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textColor="@color/black"
                            android:text="IFB Pvt Ltd."></TextView>
                    </LinearLayout>

                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp">
                    <TextView
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/pinkone"
                        android:text="Capture Proof"></TextView>
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/camera"></ImageView>
                </LinearLayout>
                <LinearLayout
                    android:layout_marginTop="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:background="@drawable/lldesign21"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/pinkone"
                        android:text="Upload Here"></TextView>
                </LinearLayout>
                <TextView
                    android:text="Outcome of the Meeting"
                    android:textColor="@color/pinkone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:layout_marginTop="20dp"></TextView>
                <EditText
                    android:padding="10dp"
                    android:gravity="top"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/lldesign21"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"></EditText>
                <LinearLayout
                    android:layout_marginTop="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <LinearLayout
                            android:visibility="gone"
                            android:id="@+id/llPrivateReim"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="20dp"
                            android:background="@drawable/lldesign"
                            android:backgroundTint="@color/bar1"
                            android:padding="10dp">
                            <TextView
                                android:layout_marginBottom="10dp"
                                android:text="Reimbursement Docs."
                                android:textColor="@color/pinkone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="14sp"
                                ></TextView>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <LinearLayout
                                    android:layout_gravity="center_vertical"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="0.5">
                                    <ImageView
                                        android:layout_gravity="center"
                                        android:layout_width="15dp"
                                        android:layout_height="15dp"
                                        android:src="@drawable/docicon"
                                        app:tint="@color/pinkone"></ImageView>
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textSize="14sp"
                                        android:textColor="@color/black"
                                        android:layout_marginLeft="5dp"
                                        android:text="Do you pay toll?"></TextView>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="0.5"
                                    android:gravity="right">
                                    <Switch
                                        android:id="@+id/swToll"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"></Switch>
                                    <LinearLayout
                                        android:visibility="gone"
                                        android:layout_gravity="center_vertical"
                                        android:orientation="horizontal"
                                        android:id="@+id/llTollDoc"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content">
                                        <LinearLayout
                                            android:padding="5dp"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:gravity="center"
                                            android:background="@drawable/lldesign21">
                                            <ImageView
                                                android:layout_width="15dp"
                                                android:layout_height="15dp"
                                                android:src="@drawable/attach_document"></ImageView>
                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:textSize="12sp"
                                                android:textColor="@color/black"
                                                android:text="Upload File"></TextView>

                                        </LinearLayout>
                                        <ImageView
                                            android:visibility="gone"
                                            android:id="@+id/imgToll"
                                            android:layout_width="30dp"
                                            android:layout_height="30dp"></ImageView>
                                    </LinearLayout>
                                </LinearLayout>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_marginTop="20dp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <LinearLayout
                                    android:layout_gravity="center_vertical"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="0.5">
                                    <ImageView
                                        android:layout_gravity="center"
                                        android:layout_width="15dp"
                                        android:layout_height="15dp"
                                        android:src="@drawable/docicon"
                                        app:tint="@color/pinkone"></ImageView>
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textSize="14sp"
                                        android:textColor="@color/black"
                                        android:layout_marginLeft="5dp"
                                        android:text="Do you pay parking?"></TextView>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="0.5"
                                    android:gravity="right">
                                    <Switch
                                        android:id="@+id/swParking"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"></Switch>
                                    <LinearLayout
                                        android:visibility="gone"
                                        android:layout_gravity="center_vertical"
                                        android:orientation="horizontal"
                                        android:id="@+id/llTollParking"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content">
                                        <LinearLayout
                                            android:padding="5dp"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:gravity="center"
                                            android:background="@drawable/lldesign21">
                                            <ImageView
                                                android:layout_width="15dp"
                                                android:layout_height="15dp"
                                                android:src="@drawable/attach_document"></ImageView>
                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:textSize="12sp"
                                                android:textColor="@color/black"
                                                android:text="Upload File"></TextView>

                                        </LinearLayout>
                                        <ImageView
                                            android:visibility="gone"
                                            android:id="@+id/imgParking"
                                            android:layout_width="30dp"
                                            android:layout_height="30dp"></ImageView>
                                    </LinearLayout>
                                </LinearLayout>
                            </LinearLayout>

                        </LinearLayout>
                        <LinearLayout
                            android:visibility="gone"
                            android:background="@drawable/lldesign"
                            android:backgroundTint="@color/bar1"
                            android:layout_marginTop="20dp"
                            android:id="@+id/llPublicReim"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="10dp"
                            android:orientation="vertical">
                            <TextView
                                android:layout_marginBottom="20dp"
                                android:text="Reimbursement Docs."
                                android:textColor="@color/pinkone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="14sp"
                                ></TextView>
                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rvDocument"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:nestedScrollingEnabled="false"></androidx.recyclerview.widget.RecyclerView>
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>
                <TextView
                    android:layout_marginBottom="20dp"
                    android:id="@+id/tvSave"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/lldesign"
                    android:backgroundTint="@color/pink"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:text="End Meeting"></TextView>



            </LinearLayout>
        </androidx.core.widget.NestedScrollView>


    </LinearLayout>
</LinearLayout>