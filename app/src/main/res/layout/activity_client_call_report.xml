<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.clientcall.ClientCallReportActivity"
    android:orientation="vertical"
    android:background="@mipmap/ccd_bg">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="20dp"
        android:paddingHorizontal="10dp">
        <ImageView
            android:id="@+id/imgBack"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/backimg"
            app:tint="@color/white"></ImageView>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center">
            <TextView
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textColor="@color/white"
                android:text="Report"></TextView>
        </LinearLayout>
        <ImageView

            android:id="@+id/imgHome"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/homeimg"
            app:tint="@color/white"></ImageView>
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            android:padding="20dp"
            android:background="@drawable/lldesign"
            android:orientation="vertical">
            <TextView
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Report Type"
                android:textSize="14sp"
                android:textStyle="normal"
                android:gravity="center"
                android:lineSpacingExtra="0dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <LinearLayout
                    android:id="@+id/llDaily"
                    android:background="@drawable/lldesign21"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1">
                    <LinearLayout
                        android:layout_marginHorizontal="5dp"
                        android:layout_gravity="center"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:gravity="center"
                        android:background="@drawable/lldesign2">
                        <LinearLayout
                            android:visibility="visible"
                            android:orientation="vertical"
                            android:id="@+id/llDailySelected"
                            android:layout_marginHorizontal="10dp"
                            android:layout_gravity="center"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:gravity="center"
                            android:background="@drawable/lldesign2"
                            android:backgroundTint="@color/black"></LinearLayout>
                    </LinearLayout>
                    <TextView
                        android:textColor="@color/color7"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Today's Activity"
                        android:textSize="14sp"
                        android:textStyle="normal"
                        android:layout_gravity="center"
                        android:lineSpacingExtra="0dp" />
                    <ImageView
                        android:layout_gravity="center"
                        android:layout_marginLeft="10dp"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/only_today"></ImageView>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/llDay"
                    android:layout_marginLeft="10dp"
                    android:background="@drawable/lldesign21"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1">
                    <LinearLayout
                        android:layout_marginHorizontal="5dp"
                        android:layout_gravity="center"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:gravity="center"
                        android:background="@drawable/lldesign2">
                        <LinearLayout
                            android:visibility="gone"
                            android:orientation="vertical"
                            android:id="@+id/llDaySelected"
                            android:layout_marginHorizontal="10dp"
                            android:layout_gravity="center"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:gravity="center"
                            android:background="@drawable/lldesign2"
                            android:backgroundTint="@color/black"></LinearLayout>
                    </LinearLayout>
                    <TextView
                        android:textColor="@color/color7"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Date Wise"
                        android:textSize="14sp"
                        android:textStyle="normal"
                        android:layout_gravity="center"
                        android:lineSpacingExtra="0dp" />
                    <ImageView
                        android:layout_gravity="center"
                        android:layout_marginLeft="10dp"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/date_wise"></ImageView>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:visibility="gone"
                android:id="@+id/llDateWise"
                android:background="@drawable/lldesign21"
                android:padding="10dp"
                android:layout_marginTop="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/pinkone"
                        android:text="Start Date"
                        android:layout_weight="0.5"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"></TextView>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="right">
                        <TextView
                            android:id="@+id/tvStartDate"
                            android:textSize="14sp"
                            android:textColor="@color/black"
                            android:text="08 May 2026"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"></TextView>
                        <ImageView
                            android:layout_marginRight="10dp"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/calendar"
                            app:tint="@color/pink"></ImageView>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_marginTop="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/pinkone"
                        android:text="End Date"
                        android:layout_weight="0.5"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"></TextView>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="right">
                        <TextView
                            android:id="@+id/tvEndDate"
                            android:textSize="14sp"
                            android:textColor="@color/black"
                            android:text="15 May 2026"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"></TextView>
                        <ImageView
                            android:layout_marginRight="10dp"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/calendar"
                            app:tint="@color/pink"></ImageView>
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:background="@drawable/lldesign"
                    android:backgroundTint="@color/pink"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:text="Show Report"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="20dp"></TextView>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:id="@+id/llReport">
                <LinearLayout
                    android:layout_marginTop="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp"
                    android:background="@drawable/lldesign"
                    android:backgroundTint="@color/pinkone"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_gravity="center"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:layout_weight="1"
                            android:textColor="@color/white"
                            android:text="Physical Call"></TextView>
                        <LinearLayout
                            android:gravity="center"
                            android:background="@drawable/lldesign2"
                            android:backgroundTint="@color/pink"
                            android:layout_width="30dp"
                            android:layout_height="30dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="12sp"
                                android:textColor="@color/white"
                                android:textStyle="bold"
                                android:id="@+id/tvPhyCount"
                                android:text="2"></TextView>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_marginTop="20dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_gravity="center"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:layout_weight="1"
                            android:textColor="@color/white"
                            android:text="Virtual Call"></TextView>
                        <LinearLayout
                            android:gravity="center"
                            android:background="@drawable/lldesign2"
                            android:backgroundTint="@color/pink"
                            android:layout_width="30dp"
                            android:layout_height="30dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="12sp"
                                android:textColor="@color/white"
                                android:textStyle="bold"
                                android:id="@+id/tvVirtualCount"
                                android:text="2"></TextView>
                        </LinearLayout>
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/white"
                        android:layout_marginVertical="20dp"></View>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/distance"
                                app:tint="@color/white"></ImageView>
                            <TextView
                                android:layout_marginLeft="5dp"
                                android:layout_weight="1"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:textSize="14sp"
                                android:textColor="@color/white"
                                android:text="Total Dist. Traveled"></TextView>
                            <TextView
                                android:gravity="right"
                                android:layout_weight="1"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:textSize="14sp"
                                android:textColor="@color/white"
                                android:text="120 KM"></TextView>
                        </LinearLayout>


                    </LinearLayout>
                    <LinearLayout
                        android:layout_marginTop="5dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/time"
                                app:tint="@color/white"></ImageView>
                            <TextView
                                android:layout_marginLeft="5dp"
                                android:layout_weight="1"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:textSize="14sp"
                                android:textColor="@color/white"
                                android:text="Total Call Time"></TextView>
                            <TextView
                                android:gravity="right"
                                android:layout_weight="1"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:textSize="14sp"
                                android:textColor="@color/white"
                                android:text="2 Hr. 20 Min"></TextView>
                        </LinearLayout>


                    </LinearLayout>

                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="20dp"
                    android:id="@+id/llPhysicalDetails">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/pinkone"
                        android:text="Physical Visit Details"></TextView>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="10dp"
                        android:background="@color/pinkone"></View>
                    <androidx.recyclerview.widget.RecyclerView
                        android:layout_marginTop="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/rvPhysical"
                        android:nestedScrollingEnabled="false"></androidx.recyclerview.widget.RecyclerView>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="20dp"
                    android:id="@+id/llVirtualDetails">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/pinkone"
                        android:text="Virtual Call Details"></TextView>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="10dp"
                        android:background="@color/pinkone"></View>
                    <androidx.recyclerview.widget.RecyclerView
                        android:layout_marginBottom="30dp"
                        android:layout_marginTop="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/rvVirtual"
                        android:nestedScrollingEnabled="false"></androidx.recyclerview.widget.RecyclerView>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>