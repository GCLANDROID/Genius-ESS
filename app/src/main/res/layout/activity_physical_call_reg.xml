<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.clientcall.PhysicalCallRegActivity"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:background="@mipmap/ccd_bg">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="20dp"
        android:paddingHorizontal="10dp">
        <ImageView
            android:id="@+id/imgBack"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/backimg"
            app:tint="@color/white"></ImageView>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center">
            <TextView
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textColor="@color/white"
                android:text="Physical Call"></TextView>
        </LinearLayout>
        <ImageView

            android:id="@+id/imgHome"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/homeimg"
            app:tint="@color/white"></ImageView>
    </LinearLayout>
    <ImageView
        android:src="@mipmap/ps_call"
        android:layout_gravity="center"
        android:layout_width="280dp"
        android:layout_height="150dp"></ImageView>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <LinearLayout
                android:visibility="visible"
                android:id="@+id/llMain"
                android:layout_marginBottom="60dp"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="20dp"
                android:background="@drawable/lldesign"
                android:paddingHorizontal="20dp"
                android:paddingVertical="20dp">

                <TextView
                    android:id="@+id/tvClientTitle"
                    android:layout_marginTop="15dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:text="Name of the Client / Vendor / Official Work"></TextView>
                <EditText
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:id="@+id/etClientName"
                    android:paddingLeft="10dp"
                    android:hint="eg."
                    android:background="@drawable/lldesign21"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"></EditText>

                <androidx.recyclerview.widget.RecyclerView
                    android:layout_marginTop="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:id="@+id/rvSPOC"></androidx.recyclerview.widget.RecyclerView>
                <LinearLayout
                    android:id="@+id/llAddSPOC"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/lldesign"
                    android:backgroundTint="@color/pinkone">
                    <TextView
                        android:id="@+id/tvAddSpocTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/white"
                        android:text="Add SPOC Information"></TextView>
                    <ImageView
                        android:layout_marginLeft="10dp"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_add_black_24dp"></ImageView>
                </LinearLayout>
                <TextView

                    android:layout_marginTop="20dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:text="Purpose of Call"></TextView>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/llOtherOption"
                    android:layout_marginTop="15dp"
                    android:background="@drawable/lldesign21">
                    <Spinner
                        android:id="@+id/spPurpose"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"></Spinner>
                </LinearLayout>
                <TextView

                    android:layout_marginTop="20dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:text="Client Address"></TextView>
                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/etClientAddress"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:background="@drawable/lldesign21"
                    android:paddingLeft="10dp"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:dropDownHeight="300dp"
                    android:dropDownWidth="match_parent"
                    android:completionThreshold="1"
                    android:layout_marginTop="10dp"/>
                <TextView
                    android:layout_marginTop="20dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:text="Travel Location"></TextView>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">
                    <LinearLayout
                        android:id="@+id/llState"
                        android:background="@drawable/lldesign21"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1">
                        <LinearLayout
                            android:layout_marginHorizontal="10dp"
                            android:layout_gravity="center"
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:gravity="center"
                            android:background="@drawable/lldesign2">
                            <LinearLayout
                                android:visibility="gone"
                                android:orientation="vertical"
                                android:id="@+id/llStateSelected"
                                android:layout_marginHorizontal="10dp"
                                android:layout_gravity="center"
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:gravity="center"
                                android:background="@drawable/lldesign2"
                                android:backgroundTint="@color/black"></LinearLayout>
                        </LinearLayout>
                        <TextView
                            android:textColor="@color/color7"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Within State"
                            android:textSize="14sp"
                            android:textStyle="normal"
                            android:layout_gravity="center"
                            android:lineSpacingExtra="0dp" />

                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/llOutside"
                        android:layout_marginLeft="10dp"
                        android:background="@drawable/lldesign21"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1">
                        <LinearLayout
                            android:layout_marginHorizontal="10dp"
                            android:layout_gravity="center"
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:gravity="center"
                            android:background="@drawable/lldesign2">
                            <LinearLayout
                                android:visibility="gone"
                                android:orientation="vertical"
                                android:id="@+id/llOutsideSelected"
                                android:layout_marginHorizontal="10dp"
                                android:layout_gravity="center"
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:gravity="center"
                                android:background="@drawable/lldesign2"
                                android:backgroundTint="@color/black"></LinearLayout>
                        </LinearLayout>
                        <TextView
                            android:textColor="@color/color7"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Outside State"
                            android:textSize="14sp"
                            android:textStyle="normal"
                            android:layout_gravity="center"
                            android:lineSpacingExtra="0dp" />

                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:layout_marginTop="20dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:text="Travel Mode"></TextView>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">
                    <LinearLayout
                        android:id="@+id/llPublic"
                        android:background="@drawable/lldesign21"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1">
                        <LinearLayout
                            android:layout_marginHorizontal="10dp"
                            android:layout_gravity="center"
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:gravity="center"
                            android:background="@drawable/lldesign2">
                            <LinearLayout
                                android:visibility="gone"
                                android:orientation="vertical"
                                android:id="@+id/llPublicSelected"
                                android:layout_marginHorizontal="10dp"
                                android:layout_gravity="center"
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:gravity="center"
                                android:background="@drawable/lldesign2"
                                android:backgroundTint="@color/black"></LinearLayout>
                        </LinearLayout>
                        <TextView
                            android:textColor="@color/color7"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Public"
                            android:textSize="14sp"
                            android:textStyle="normal"
                            android:layout_gravity="center"
                            android:lineSpacingExtra="0dp" />

                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/llPrivate"
                        android:layout_marginLeft="10dp"
                        android:background="@drawable/lldesign21"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1">
                        <LinearLayout
                            android:layout_marginHorizontal="10dp"
                            android:layout_gravity="center"
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:gravity="center"
                            android:background="@drawable/lldesign2">
                            <LinearLayout
                                android:visibility="gone"
                                android:orientation="vertical"
                                android:id="@+id/llPrivateSelected"
                                android:layout_marginHorizontal="10dp"
                                android:layout_gravity="center"
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:gravity="center"
                                android:background="@drawable/lldesign2"
                                android:backgroundTint="@color/black"></LinearLayout>
                        </LinearLayout>
                        <TextView
                            android:textColor="@color/color7"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Private"
                            android:textSize="14sp"
                            android:textStyle="normal"
                            android:layout_gravity="center"
                            android:lineSpacingExtra="0dp" />

                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:id="@+id/llPublicTransport"
                    android:orientation="vertical">
                    <TextView
                        android:layout_marginTop="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/black"
                        android:text="Transportation"></TextView>
                    <LinearLayout

                        android:layout_marginTop="5dp"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:background="@drawable/lldesign21">
                        <HorizontalScrollView
                            android:id="@+id/spPublic"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scrollbars="none"
                            android:fillViewport="true"
                            android:clickable="true"
                            android:focusable="true">

                            <LinearLayout
                                android:layout_gravity="center"
                                android:id="@+id/llChipContainer"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"/>

                        </HorizontalScrollView>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:id="@+id/llPrivateTransport"
                    android:orientation="vertical">
                    <TextView
                        android:layout_marginTop="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/black"
                        android:text="Transportation"></TextView>
                    <LinearLayout
                        android:layout_marginTop="5dp"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@drawable/lldesign21">
                        <Spinner
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:id="@+id/spPrivate"></Spinner>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/llSharingOption"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="20dp">
                    <TextView
                        android:layout_marginTop="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/black"
                        android:text="Sharing Option"></TextView>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp">
                        <LinearLayout
                            android:id="@+id/llOWNShare"
                            android:background="@drawable/lldesign21"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1">
                            <LinearLayout
                                android:layout_marginHorizontal="10dp"
                                android:layout_gravity="center"
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:gravity="center"
                                android:background="@drawable/lldesign2">
                                <LinearLayout
                                    android:visibility="gone"
                                    android:orientation="vertical"
                                    android:id="@+id/llOWNShareSelected"
                                    android:layout_marginHorizontal="10dp"
                                    android:layout_gravity="center"
                                    android:layout_width="10dp"
                                    android:layout_height="10dp"
                                    android:gravity="center"
                                    android:background="@drawable/lldesign2"
                                    android:backgroundTint="@color/black"></LinearLayout>
                            </LinearLayout>
                            <TextView
                                android:textColor="@color/color7"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Own"
                                android:textSize="14sp"
                                android:textStyle="normal"
                                android:layout_gravity="center"
                                android:lineSpacingExtra="0dp" />

                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/llOtherSharing"
                            android:layout_marginLeft="10dp"
                            android:background="@drawable/lldesign21"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1">
                            <LinearLayout
                                android:layout_marginHorizontal="10dp"
                                android:layout_gravity="center"
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:gravity="center"
                                android:background="@drawable/lldesign2">
                                <LinearLayout
                                    android:visibility="gone"
                                    android:orientation="vertical"
                                    android:id="@+id/llOtherSharingSelected"
                                    android:layout_marginHorizontal="10dp"
                                    android:layout_gravity="center"
                                    android:layout_width="10dp"
                                    android:layout_height="10dp"
                                    android:gravity="center"
                                    android:background="@drawable/lldesign2"
                                    android:backgroundTint="@color/black"></LinearLayout>
                            </LinearLayout>
                            <TextView
                                android:textColor="@color/color7"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Sharing with others"
                                android:textSize="14sp"
                                android:textStyle="normal"
                                android:layout_gravity="center"
                                android:lineSpacingExtra="0dp" />

                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <TextView

                    android:layout_marginTop="20dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:text="Supporting Document (If Any)"></TextView>
                <LinearLayout
                    android:paddingHorizontal="20dp"
                    android:layout_marginTop="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/lldesign21">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/color6"
                        android:layout_gravity="center"
                        android:text="Upload"></TextView>
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/attach_document"
                        app:tint="@color/color6"></ImageView>
                </LinearLayout>

                <TextView
                    android:layout_marginBottom="30dp"
                    android:id="@+id/tvSave"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/lldesign"
                    android:backgroundTint="@color/pink"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:text="Register"></TextView>
            </LinearLayout>
            <LinearLayout
                android:visibility="gone"
                android:id="@+id/llSPOCPopup"
                android:layout_marginBottom="60dp"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="20dp"
                android:background="@drawable/lldesign"
                android:paddingHorizontal="10dp"
                android:paddingVertical="10dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="right">
                    <ImageView
                        android:id="@+id/imgCross"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/close"
                        app:tint="@color/black"></ImageView>
                </LinearLayout>
                <TextView
                    android:layout_marginTop="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:text="Name"></TextView>
                <EditText
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:id="@+id/etSPOCName"
                    android:paddingLeft="10dp"
                    android:hint="eg."
                    android:background="@drawable/lldesign21"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"></EditText>

                <TextView
                    android:inputType="text"
                    android:layout_marginTop="15dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:text="Mobile Number"></TextView>
                <EditText
                    android:maxLength="10"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:id="@+id/etMobile"
                    android:paddingLeft="10dp"
                    android:inputType="number"
                    android:background="@drawable/lldesign21"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"></EditText>

                <TextView
                    android:inputType="text"
                    android:layout_marginTop="15dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:text="Email ID"></TextView>
                <EditText
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:id="@+id/etEmail"
                    android:paddingLeft="10dp"
                    android:inputType="textEmailAddress"
                    android:background="@drawable/lldesign21"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"></EditText>

                <TextView
                    android:inputType="text"
                    android:layout_marginTop="15dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:text="Department"></TextView>
                <EditText
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:id="@+id/etDepartment"
                    android:paddingLeft="10dp"
                    android:inputType="textEmailAddress"
                    android:background="@drawable/lldesign21"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"></EditText>

                <TextView
                    android:inputType="text"
                    android:layout_marginTop="15dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:text="Designation"></TextView>
                <EditText
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:id="@+id/etDesignation"
                    android:paddingLeft="10dp"
                    android:inputType="textEmailAddress"
                    android:background="@drawable/lldesign21"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"></EditText>

                <TextView
                    android:layout_marginBottom="30dp"
                    android:id="@+id/tvSaveSPOC"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/lldesign"
                    android:backgroundTint="@color/pink"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:text="Add SPOC Details"></TextView>
            </LinearLayout>
        </LinearLayout>

    </ScrollView>
</LinearLayout>