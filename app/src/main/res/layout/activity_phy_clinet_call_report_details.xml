<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@mipmap/ccd_bg"
    tools:context=".activity.clientcall.PhyClinetCallReportDetailsActivity">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="20dp"
        android:paddingHorizontal="10dp">
        <ImageView
            android:id="@+id/imgBack"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/backimg"
            app:tint="@color/white"></ImageView>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center">
            <TextView
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textColor="@color/white"
                android:text="Visit Details"></TextView>
        </LinearLayout>
        <ImageView

            android:id="@+id/imgHome"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/homeimg"
            app:tint="@color/white"></ImageView>
    </LinearLayout>
    <LinearLayout
        android:background="@drawable/lldesign"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:orientation="vertical">
        <TextView
            android:textStyle="bold"
            android:text="IFB PVT LTD."
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="@color/pinkone"></TextView>
        <TextView
            android:layout_marginTop="10dp"
            android:text="14 May 2026."
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/color7"></TextView>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_marginTop="20dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">
                <LinearLayout
                    android:padding="20dp"
                    android:backgroundTint="@color/pinktwo"
                    android:background="@drawable/lldesign"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/pinkone"
                        android:text="Purpose of Call"></TextView>
                    <TextView
                        android:textColor="@color/black"
                        android:text="System releted discussion"
                        android:layout_marginTop="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"></TextView>
                </LinearLayout>
                <LinearLayout
                    android:layout_marginTop="20dp"
                    android:padding="20dp"
                    android:backgroundTint="@color/pinktwo"
                    android:background="@drawable/lldesign"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/pinkone"
                        android:text="Client Address"></TextView>
                   <TextView
                       android:textColor="@color/black"
                       android:text="15, 100 Feet Ring Rd, BTM 2nd Stage, Kuvempu Nagar, BTM Layout 2nd Stage, BTM Layout, Bengaluru, Karnataka 560076"
                       android:layout_marginTop="10dp"
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:textSize="12sp"></TextView>
                </LinearLayout>
                <LinearLayout
                    android:layout_marginTop="20dp"
                    android:padding="20dp"
                    android:backgroundTint="@color/pinktwo"
                    android:background="@drawable/lldesign"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/pinkone"
                        android:text="SPOC Information"></TextView>
                    <androidx.recyclerview.widget.RecyclerView
                        android:layout_marginTop="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:id="@+id/rvSPOC"></androidx.recyclerview.widget.RecyclerView>
                </LinearLayout>
                <LinearLayout
                    android:layout_marginTop="20dp"
                    android:padding="20dp"
                    android:backgroundTint="@color/pinkone"
                    android:background="@drawable/lldesign"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/distance"
                        app:tint="@color/white"></ImageView>
                    <TextView
                        android:layout_marginLeft="10dp"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:text="Total Dist. Travel"></TextView>
                    <TextView
                        android:textColor="@color/white"
                        android:text="200 KM"
                        android:layout_marginLeft="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"></TextView>
                </LinearLayout>
                <LinearLayout
                    android:layout_marginTop="20dp"
                    android:padding="20dp"
                    android:backgroundTint="@color/pinktwo"
                    android:background="@drawable/lldesign"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/pinkone"
                        android:text="Outcome of the Meeting"></TextView>
                    <TextView
                        android:textColor="@color/black"
                        android:text="Effective meeting outcome templates focus on decisions, action items, and clear ownership rather than word-for-word transcripts. Below are examples based on common meeting types, ranging from concise summaries to structured reports"
                        android:layout_marginTop="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"></TextView>
                </LinearLayout>
                <LinearLayout
                    android:layout_marginVertical="20dp"
                    android:padding="20dp"
                    android:backgroundTint="@color/pinktwo"
                    android:background="@drawable/lldesign"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/pinkone"
                        android:text="Reimbursement Docs"></TextView>
                    <androidx.recyclerview.widget.RecyclerView
                        android:layout_marginTop="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:id="@+id/rvDoc"></androidx.recyclerview.widget.RecyclerView>
                </LinearLayout>
                <LinearLayout
                    android:visibility="gone"
                    android:id="@+id/llReturnTrip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="20dp">
                    <TextView
                        android:id="@+id/tvAddRetTrip"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:background="@drawable/lldesign"
                        android:backgroundTint="@color/pink"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:text="Add Return Trip"></TextView>
                    <LinearLayout
                        android:visibility="gone"
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/lldesign"
                        android:backgroundTint="@color/pinktwo"
                        android:layout_marginTop="20dp"
                        android:id="@+id/llAddTrip"
                        android:padding="20dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:layout_gravity="center"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/pinkone"
                                android:textSize="14sp"
                                android:text="Do you stay in hotel ?"></TextView>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="right">
                                <Switch
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:id="@+id/swHotel"></Switch>
                                <LinearLayout
                                    android:visibility="gone"
                                    android:layout_gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:id="@+id/llHotel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content">
                                    <LinearLayout
                                        android:padding="5dp"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:gravity="center"
                                        android:background="@drawable/lldesign21">
                                        <ImageView
                                            android:layout_width="15dp"
                                            android:layout_height="15dp"
                                            android:src="@drawable/attach_document"></ImageView>
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="12sp"
                                            android:textColor="@color/black"
                                            android:text="Upload File"></TextView>

                                    </LinearLayout>
                                    <ImageView
                                        android:visibility="gone"
                                        android:id="@+id/imgParking"
                                        android:layout_width="30dp"
                                        android:layout_height="30dp"></ImageView>
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_marginTop="20dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:layout_gravity="center"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/pinkone"
                                android:textSize="14sp"
                                android:text="Do you have any \nother expenses ?"></TextView>
                            <LinearLayout
                                android:layout_gravity="center"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="right">
                                <Switch
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:id="@+id/swOtherExp"></Switch>
                                <LinearLayout
                                    android:visibility="gone"
                                    android:layout_gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:id="@+id/llExp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content">
                                    <LinearLayout
                                        android:padding="5dp"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:gravity="center"
                                        android:background="@drawable/lldesign21">
                                        <ImageView
                                            android:layout_width="15dp"
                                            android:layout_height="15dp"
                                            android:src="@drawable/attach_document"></ImageView>
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="12sp"
                                            android:textColor="@color/black"
                                            android:text="Upload File"></TextView>

                                    </LinearLayout>
                                    <ImageView
                                        android:visibility="gone"
                                        android:id="@+id/imgOtherExp"
                                        android:layout_width="30dp"
                                        android:layout_height="30dp"></ImageView>
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp">
                            <TextView
                                android:layout_weight="1"
                                android:text="Travel Docs."
                                android:textColor="@color/pinkone"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:textSize="14sp"
                                ></TextView>
                            <TextView
                                android:background="@drawable/lldesign"
                                android:backgroundTint="@color/pink"
                                android:gravity="center"
                                android:textColor="@color/white"
                                android:textSize="14sp"
                                android:text="Add Doc."
                                android:layout_width="100dp"
                                android:layout_height="30dp"></TextView>
                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:layout_marginTop="10dp"
                            android:id="@+id/rvTravelDocument"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"></androidx.recyclerview.widget.RecyclerView>
                        <TextView
                            android:layout_marginTop="20dp"
                            android:id="@+id/tvSaveTrip"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:gravity="center"
                            android:background="@drawable/lldesign"
                            android:backgroundTint="@color/pinkone"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:text="Save"></TextView>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>